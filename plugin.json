{
    "id": "mihomoIndicator",
    "name": "Mihomo Indicator",
    "description": "Shows mihomo status, live traffic and the active proxy in DankBar, with a popout to switch proxy groups and modes",
    "version": "1.0.0",
    "license": "MIT",
    "author": "Nixie24",
    "icon": "vpn_lock",
    "type": "widget",
    "capabilities": [
        "dankbar-widget"
    ],
    "component": "./MihomoWidget.qml",
    "settings": "./MihomoSettings.qml",
    "startupCheck": "./StartupCheck.qml",
    "requires_dms": ">=2.1.0",
    "dependencies": [
        "curl"
    ],
    "permissions": [
        "settings_read",
        "settings_write",
        "process"
    ]
}
